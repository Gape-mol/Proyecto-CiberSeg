# GitHub auth — requerido para clonar repos y obtener metadatos de orgs
GITHUB_TOKEN=ghp_replace_me

# HuggingFace token — recomendado para evitar rate limits al descargar AIDev
# Obtener en: https://huggingface.co/settings/tokens
HF_TOKEN=

# Filtro de organizaciones del dataset AIDev (opcional)
# Dejar vacío para procesar todas las organizaciones disponibles
# Separar con comas para múltiples orgs: AIDEV_ORG_FILTER=org-a,org-b
AIDEV_ORG_FILTER=

# Mínimo de stars para incluir repos del dataset (default: 0 = todos)
AIDEV_REPO_MIN_STARS=0
